# —— 行尾规范 ——
# 这台机器的 cmd.exe 按 UTF-8 读 .bat，并且 CRLF 是硬要求：
# LF-only 的批处理会被解析错位（曾经把 `call` 拆成 `ca` + `ll`）。
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf

# Godot / Python 侧统一 LF
*.gd    text eol=lf
*.tscn  text eol=lf
*.tres  text eol=lf
*.csv   text eol=lf
*.py    text eol=lf
*.md    text eol=lf

# —— 二进制 ——
*.png  binary
*.jpg  binary
*.jpeg binary
*.gif  binary
*.webp binary
*.ogg  binary
*.wav  binary
*.ctex binary
*.ttf  binary
*.otf  binary
